<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsTestProject>true</IsTestProject>
		<Platforms>AnyCPU;x64</Platforms>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit" Version="2.9.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Moq" Version="4.20.70" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
		<PackageReference Include="FluentAssertions" Version="6.12.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Pico8/Pico8.csproj" />
		<ProjectReference Include="..\CSharpCraft.Game\CSharpCraft.Game.csproj" />
	</ItemGroup>

	<!-- Native FNA libraries required for headless GPU testing on Linux.
	     CSharpCraft.Game builds first (via ProjectReference above), so
	     these files are guaranteed to exist before this project copies them. -->
	<ItemGroup Condition="'$(OS)' != 'Windows_NT'">
		<None Include="..\CSharpCraft.Game\bin\$(Configuration)\$(TargetFramework)\libSDL3.so.0">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</None>
		<None Include="..\CSharpCraft.Game\bin\$(Configuration)\$(TargetFramework)\libFNA3D.so.0">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</None>
		<None Include="..\CSharpCraft.Game\bin\$(Configuration)\$(TargetFramework)\libFAudio.so.0">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</None>
		<None Include="..\CSharpCraft.Game\bin\$(Configuration)\$(TargetFramework)\libtheorafile.so">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</None>
	</ItemGroup>

</Project>
